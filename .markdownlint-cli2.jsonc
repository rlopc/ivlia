// Rules live in .markdownlint.jsonc; this file sets which files are skipped.
{
  // Gitignored files (node_modules/, .dev/, local files) are skipped.
  "gitignore": true,
  "ignores": [
    // Generated by OpenSpec; regenerate with `openspec update`.
    ".claude/commands/opsx/**",
    ".claude/skills/openspec-*/**",
    // Generated by release-please, which repeats section headings (MD024).
    "CHANGELOG.md"
  ]
}
