{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(just)",
      "Bash(just *)",
      "Bash(mise exec -- just *)",
      "Bash(uv run --locked *)",
      "Bash(uv sync --locked --all-packages*)",
      "Bash(pnpm install --frozen-lockfile*)",
      "Bash(pnpm exec *)",
      "Bash(pnpm run *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch)",
      "Bash(git branch --list*)",
      "Bash(git branch --show-current)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(.claude/bin/gh-repo.sh pr view *)",
      "Bash(.claude/bin/gh-repo.sh pr diff *)",
      "Bash(.claude/bin/gh-repo.sh pr checks *)",
      "Bash(.claude/bin/gh-repo.sh pr list *)",
      "Bash(.claude/bin/gh-repo.sh pr status *)",
      "Bash(.claude/bin/gh-repo.sh run list *)",
      "Bash(.claude/bin/gh-repo.sh run view *)",
      "Bash(.claude/bin/gh-repo.sh issue view *)",
      "Bash(.claude/bin/gh-repo.sh issue list *)",
      "Bash(.claude/bin/gh-repo.sh repo view *)"
    ],
    "ask": [
      "Bash(just setup*)",
      "Bash(just update-tools*)",
      "Bash(mise exec -- just setup*)",
      "Bash(mise exec -- just update-tools*)",
      "Bash(pnpm dlx *)",
      "Bash(pnpm create *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm update*)",
      "Bash(uvx *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv lock --upgrade*)",
      "Bash(uv pip *)",
      "Bash(uv tool *)",
      "Bash(git push*)",
      "Bash(git rebase*)",
      "Bash(git commit --amend*)",
      "Bash(git reset*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git clean*)",
      "Bash(git rm *)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "WebFetch",
      "WebSearch",
      "Bash(git commit * --amend*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n *)",
      "Bash(git switch -f*)",
      "Bash(git switch -C*)",
      "Bash(git switch *--discard-changes*)",
      "Bash(.claude/bin/gh-repo.sh pr create *)",
      "Bash(.claude/bin/gh-repo.sh pr edit *)",
      "Bash(.claude/bin/gh-repo.sh pr comment *)",
      "Bash(.claude/bin/gh-repo.sh pr review *)",
      "Bash(.claude/bin/gh-repo.sh pr ready *)",
      "Bash(.claude/bin/gh-repo.sh pr close *)",
      "Bash(.claude/bin/gh-repo.sh pr reopen *)",
      "Bash(.claude/bin/gh-repo.sh pr merge *)",
      "Bash(.claude/bin/gh-repo.sh pr update-branch *)",
      "Bash(.claude/bin/gh-repo.sh run rerun *)",
      "Bash(.claude/bin/gh-repo.sh run cancel *)",
      "Bash(.claude/bin/gh-repo.sh issue create *)",
      "Bash(.claude/bin/gh-repo.sh issue edit *)",
      "Bash(.claude/bin/gh-repo.sh issue comment *)",
      "Bash(.claude/bin/gh-repo.sh issue close *)",
      "Bash(.claude/bin/gh-repo.sh issue reopen *)",
      "Bash(.claude/bin/gh-repo.sh api *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(security *)",
      "Edit(/.claude/bin/**)",
      "Write(/.claude/bin/**)",
      "Read(~/Library/Application Support/ivlia/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)",
      "Read(~/Library/Keychains/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/Library/Application Support/ivlia",
        "~/.ssh",
        "~/.gnupg",
        "~/.aws",
        "~/.config/gh",
        "~/.netrc",
        "~/Library/Keychains"
      ],
      "denyWrite": ["./.claude/bin"]
    },
    "network": {
      "allowedDomains": ["github.com", "api.github.com"]
    },
    "autoAllowBashIfSandboxed": false,
    "excludedCommands": [
      "just setup",
      "mise exec -- just setup",
      ".claude/bin/gh-repo.sh *",
      "git push *"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/python.sh\" \"${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-after-edit.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/python.sh\" \"${CLAUDE_PROJECT_DIR}/.claude/hooks/researcher-bash-guard.py\"",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
