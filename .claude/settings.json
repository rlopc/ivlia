{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(just)",
      "Bash(just *)",
      "Bash(mise exec -- just *)",
      "Bash(uv run --locked *)",
      "Bash(uv sync --locked --all-packages*)",
      "Bash(pnpm install --frozen-lockfile*)",
      "Bash(pnpm exec *)",
      "Bash(pnpm run *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch)",
      "Bash(git branch --list*)",
      "Bash(git branch --show-current)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(~/.local/bin/gh-repo pr view *)",
      "Bash(~/.local/bin/gh-repo pr diff *)",
      "Bash(~/.local/bin/gh-repo pr checks *)",
      "Bash(~/.local/bin/gh-repo pr list *)",
      "Bash(~/.local/bin/gh-repo pr status *)",
      "Bash(~/.local/bin/gh-repo run list *)",
      "Bash(~/.local/bin/gh-repo run view *)",
      "Bash(~/.local/bin/gh-repo issue view *)",
      "Bash(~/.local/bin/gh-repo issue list *)",
      "Bash(~/.local/bin/gh-repo repo view *)"
    ],
    "ask": [
      "Bash(just setup*)",
      "Bash(just update-tools*)",
      "Bash(mise exec -- just setup*)",
      "Bash(mise exec -- just update-tools*)",
      "Bash(pnpm dlx *)",
      "Bash(pnpm create *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm update*)",
      "Bash(uvx *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv lock --upgrade*)",
      "Bash(uv pip *)",
      "Bash(uv tool *)",
      "Bash(git push*)",
      "Bash(git rebase*)",
      "Bash(git commit --amend*)",
      "Bash(git reset*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git clean*)",
      "Bash(git rm *)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "WebFetch",
      "WebSearch",
      "Bash(git commit * --amend*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n *)",
      "Bash(git switch -f*)",
      "Bash(git switch -C*)",
      "Bash(git switch *--discard-changes*)",
      "Bash(~/.local/bin/gh-repo pr create *)",
      "Bash(~/.local/bin/gh-repo pr edit *)",
      "Bash(~/.local/bin/gh-repo pr comment *)",
      "Bash(~/.local/bin/gh-repo pr review *)",
      "Bash(~/.local/bin/gh-repo pr ready *)",
      "Bash(~/.local/bin/gh-repo pr close *)",
      "Bash(~/.local/bin/gh-repo pr reopen *)",
      "Bash(~/.local/bin/gh-repo pr merge *)",
      "Bash(~/.local/bin/gh-repo pr update-branch *)",
      "Bash(~/.local/bin/gh-repo run rerun *)",
      "Bash(~/.local/bin/gh-repo run cancel *)",
      "Bash(~/.local/bin/gh-repo issue create *)",
      "Bash(~/.local/bin/gh-repo issue edit *)",
      "Bash(~/.local/bin/gh-repo issue comment *)",
      "Bash(~/.local/bin/gh-repo issue close *)",
      "Bash(~/.local/bin/gh-repo issue reopen *)",
      "Bash(~/.local/bin/gh-repo api *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push *--receive-pack*)",
      "Bash(git push *--exec*)",
      "Edit(~/.local/bin/**)",
      "Write(~/.local/bin/**)",
      "Edit(/.git/hooks/**)",
      "Write(/.git/hooks/**)",
      "Edit(/.git/config)",
      "Write(/.git/config)",
      "Bash(git push *--delete*)",
      "Bash(git push * -d *)",
      "Bash(git push * :*)",
      "Bash(git push *+*)",
      "Bash(security *)",
      "Read(~/Library/Application Support/ivlia/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)",
      "Read(~/Library/Keychains/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/Library/Application Support/ivlia",
        "~/.ssh",
        "~/.gnupg",
        "~/.aws",
        "~/.config/gh",
        "~/.netrc",
        "~/Library/Keychains"
      ],
      "denyWrite": ["./.git/hooks", "./.git/config"]
    },
    "network": {
      "allowedDomains": ["github.com", "api.github.com"]
    },
    "autoAllowBashIfSandboxed": false,
    "excludedCommands": [
      "just setup",
      "mise exec -- just setup",
      "~/.local/bin/gh-repo *",
      "git push origin *",
      "git push -u origin *"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/python.sh\" \"${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-after-edit.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/python.sh\" \"${CLAUDE_PROJECT_DIR}/.claude/hooks/researcher-bash-guard.py\"",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
