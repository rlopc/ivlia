#!/usr/bin/env bash
# Run gh on this repository with its own fine-grained token, read from the
# macOS Keychain. Claude Code runs it outside the Bash sandbox, where gh can
# verify TLS (docs/standards/ai-development.md#github-access).
#
# The token's Keychain item: service "gh-repo-token", account "OWNER/REPO" of
# the origin remote. Add it once (the token is prompted for, not echoed):
#   security add-generic-password -s gh-repo-token -a OWNER/REPO -w
#
# git uses it as the only credential helper for github.com (the empty value
# drops helpers set globally, such as osxkeychain):
#   git config --replace-all credential.https://github.com.helper ''
#   git config --add credential.https://github.com.helper \
#     '!"$(git rev-parse --show-toplevel)/.claude/bin/gh-repo" auth git-credential'
set -euo pipefail

remote="$(git remote get-url origin)"
# git@github.com:OWNER/REPO.git, ssh://git@github.com/OWNER/REPO.git or
# https://github.com/OWNER/REPO(.git)
repo="${remote#*github.com[:/]}"
repo="${repo%.git}"
if [[ "$repo" == "$remote" || "$repo" != */* ]]; then
  echo "gh-repo: origin is not a GitHub repository: $remote" >&2
  exit 1
fi

if ! token="$(security find-generic-password -s gh-repo-token -a "$repo" -w 2> /dev/null)"; then
  echo "gh-repo: no token for $repo in the Keychain. Add it with:" >&2
  echo "  security add-generic-password -s gh-repo-token -a $repo -w" >&2
  exit 1
fi

GH_TOKEN="$token" GH_REPO="$repo" exec gh "$@"
