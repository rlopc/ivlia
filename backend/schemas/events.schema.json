{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "EndEvent": {
      "properties": {
        "type": {
          "const": "end",
          "default": "end",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "EndEvent",
      "type": "object"
    },
    "ErrorEvent": {
      "properties": {
        "type": {
          "const": "error",
          "default": "error",
          "title": "Type",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "title": "ErrorEvent",
      "type": "object"
    },
    "TokenEvent": {
      "properties": {
        "type": {
          "const": "token",
          "default": "token",
          "title": "Type",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "title": "TokenEvent",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "end": "#/$defs/EndEvent",
      "error": "#/$defs/ErrorEvent",
      "token": "#/$defs/TokenEvent"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/TokenEvent"
    },
    {
      "$ref": "#/$defs/EndEvent"
    },
    {
      "$ref": "#/$defs/ErrorEvent"
    }
  ]
}
