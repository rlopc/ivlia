# Local-only files
*.local.*
.DS_Store

# Dev installation data, Validar reports and review diffs
.dev/

# mise local state, except the lockfiles of dependency-graph tools (pre-commit),
# which mise needs to install them and which hold their checksums
.mise/*
!.mise/locks/

# Python
.venv/
__pycache__/
.coverage
.coverage.*
# Scratch folders of the lint hook test (the frontend one must not be ignored)
backend/.hook-test.*/
htmlcov/

# Node
node_modules/

# Build outputs
dist/
coverage/
# The built SPA, which FastAPI serves (ivlia.api.spa)
backend/src/ivlia/api/static/

# Playwright
playwright-report/
test-results/
